<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NitroHttp.MainPage"
             BackgroundColor="#0A0B0F">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
        <Border Grid.Row="0"
                BackgroundColor="#12141A"
                StrokeThickness="0">
            <Grid Padding="24" ColumnDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Column="1" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                Padding="0,0">
                            <Picker WidthRequest="100"
                                    TextColor="#FC4850"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    SelectedItem="GET">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>GET</x:String>
                                        <x:String>POST</x:String>
                                        <x:String>PUT</x:String>
                                        <x:String>PATCH</x:String>
                                        <x:String>DELETE</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>

                        <Entry x:Name="url"
                               Grid.Column="1"
                               Placeholder="https://api.example.com/v1/endpoint"
                               PlaceholderColor="#4A4C54"
                               BackgroundColor="Transparent"
                               TextColor="#E8E9ED"
                               FontSize="14"
                               Margin="8,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" StrokeThickness="0" HeightRequest="44.8">
                    <Button Text="Sumbit Request" BackgroundColor="#FC4850" TextColor="#fff" Clicked="Button_Click" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" 
              Padding="24,20,24,0"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <Border Grid.Column="0"
                    BackgroundColor="#FC4850"
                    StrokeThickness="0"
                    Padding="20,10"
                    Margin="0,0,12,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label Text="Params"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"/>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="20,10"
                    Margin="0,0,12,0">
                <Label Text="Headers"
                       TextColor="#6B6D75"
                       FontSize="13"/>
            </Border>

            <Border Grid.Column="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="20,10"
                    Margin="0,0,12,0">
                <Label Text="Body"
                       TextColor="#6B6D75"
                       FontSize="13"/>
            </Border>

            <Border Grid.Column="3"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="20,10"
                    Margin="0,0,12,0">
                <Label Text="Auth"
                       TextColor="#6B6D75"
                       FontSize="13"/>
            </Border>

            <HorizontalStackLayout Grid.Column="5" Spacing="12">
                <Border BackgroundColor="#1A1C24"
                        StrokeThickness="0"
                        Padding="16,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label Text="History"
                           TextColor="#6B6D75"
                           FontSize="13"/>
                </Border>

                <Border BackgroundColor="#1A1C24"
                        StrokeThickness="0"
                        Padding="16,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label Text="Collections"
                           TextColor="#6B6D75"
                           FontSize="13"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="2"
              Padding="24,20,24,24"
              ColumnDefinitions="1.3*,1.7*"
              ColumnSpacing="20">

            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="16">

                    <Border BackgroundColor="#12141A"
                            StrokeThickness="1"
                            Stroke="#1A1C24"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" 
                                    Offset="0,4" 
                                    Radius="16" 
                                    Opacity="0.3"/>
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <Grid Padding="20,16"
                                  ColumnDefinitions="*,Auto"
                                  BackgroundColor="#14161D">
                                <Label Text="Query Parameters"
                                       TextColor="#E8E9ED"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1"
                                       Text="+ Add"
                                       TextColor="#4F7CFF"
                                       FontSize="13"/>
                            </Grid>

                            <BoxView HeightRequest="1" 
                                     Color="#1A1C24"/>

                            <Grid Padding="20,16" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#1A1C24"
                                            StrokeThickness="0"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry Placeholder="key"
                                               PlaceholderColor="#4A4C54"
                                               BackgroundColor="Transparent"
                                               TextColor="#E8E9ED"
                                               FontSize="13"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#1A1C24"
                                            StrokeThickness="0"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry Placeholder="value"
                                               PlaceholderColor="#4A4C54"
                                               BackgroundColor="Transparent"
                                               TextColor="#E8E9ED"
                                               FontSize="13"/>
                                    </Border>

                                    <Label Grid.Column="2"
                                           Text="X"
                                           TextColor="#6B6D75"
                                           FontSize="16"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#1A1C24"
                                            StrokeThickness="0"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry Placeholder="key"
                                               PlaceholderColor="#4A4C54"
                                               BackgroundColor="Transparent"
                                               TextColor="#E8E9ED"
                                               FontSize="13"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#1A1C24"
                                            StrokeThickness="0"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry Placeholder="value"
                                               PlaceholderColor="#4A4C54"
                                               BackgroundColor="Transparent"
                                               TextColor="#E8E9ED"
                                               FontSize="13"/>
                                    </Border>

                                    <Label Grid.Column="2"
                                           Text="X"
                                           TextColor="#6B6D75"
                                           FontSize="16"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#12141A"
                            StrokeThickness="1"
                            Stroke="#1A1C24"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" 
                                    Offset="0,4" 
                                    Radius="16" 
                                    Opacity="0.3"/>
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <Grid Padding="20,16"
                                  ColumnDefinitions="*,Auto"
                                  BackgroundColor="#14161D">
                                <Label Text="Headers"
                                       TextColor="#E8E9ED"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1"
                                       Text="+ Add"
                                       TextColor="#4F7CFF"
                                       FontSize="13"/>
                            </Grid>

                            <BoxView HeightRequest="1" 
                                     Color="#1A1C24"/>

                            <Border Padding="20,16"
                                    BackgroundColor="#1A1C24"
                                    StrokeThickness="0"
                                    Margin="20,16,20,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Editor HeightRequest="100"
                                        BackgroundColor="Transparent"
                                        TextColor="#E8E9ED"
                                        FontSize="13"
                                        Placeholder="Content-Type: application/json"
                                        PlaceholderColor="#4A4C54"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#12141A"
                            StrokeThickness="1"
                            Stroke="#1A1C24"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" 
                                    Offset="0,4" 
                                    Radius="16" 
                                    Opacity="0.3"/>
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <Grid Padding="20,16"
                                  ColumnDefinitions="*,Auto,Auto"
                                  BackgroundColor="#14161D">
                                <Label Text="Body"
                                       TextColor="#E8E9ED"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1"
                                       Text="JSON"
                                       TextColor="#4F7CFF"
                                       FontSize="12"
                                       Margin="0,0,16,0"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="Beautify"
                                       TextColor="#6B6D75"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" 
                                     Color="#1A1C24"/>

                            <Border Padding="20,16"
                                    BackgroundColor="#1A1C24"
                                    StrokeThickness="0"
                                    Margin="20,16,20,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Editor HeightRequest="200"
                                        BackgroundColor="Transparent"
                                        TextColor="#E8E9ED"
                                        FontSize="13"
                                        Placeholder="Request body JSON"
                                        PlaceholderColor="#4A4C54"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Column="1"
                    BackgroundColor="#12141A"
                    StrokeThickness="1"
                    Stroke="#1A1C24"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" 
                            Offset="0,4" 
                            Radius="16" 
                            Opacity="0.3"/>
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout>
                        <Grid Padding="24,20"
            ColumnDefinitions="*,Auto"
            BackgroundColor="#14161D">
                            <Label Text="Response"
                 TextColor="#E8E9ED"
                 FontSize="16"
                 FontAttributes="Bold"
                 VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="16">
                                <Label Text="Save"
                     FontSize="12"
                     TextColor="#6B6D75"
                     VerticalOptions="Center"/>
                                <Label Text="Copy"
                     FontSize="12"
                     TextColor="#6B6D75"
                     VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" 
               Color="#1A1C24"/>

                        <Grid Padding="24,16"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            ColumnSpacing="20"
            BackgroundColor="#0F1115">

                            <Border Grid.Column="0"
                  BackgroundColor="#1A1C24"
                  StrokeThickness="0"
                  Padding="12,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label x:Name="status" Text="NONE"
                     TextColor="#4ADE80"
                     FontSize="12"
                     FontAttributes="Bold"/>
                            </Border>

                            <Label Grid.Column="2"
                 Text="324ms"
                 TextColor="#6B6D75"
                 FontSize="12"
                 VerticalOptions="Center"/>

                            <BoxView Grid.Column="3"
                   WidthRequest="1"
                   HeightRequest="16"
                   Color="#2A2C34"
                   VerticalOptions="Center"/>

                            <Label Grid.Column="4"
                 Text="2.4KB"
                 TextColor="#6B6D75"
                 FontSize="12"
                 VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
               Color="#1A1C24"/>

                        <Grid Padding="24,12,24,0"
            ColumnDefinitions="Auto,Auto,Auto">
                            <Border Grid.Column="0"
                  BackgroundColor="Transparent"
                  StrokeThickness="0"
                  Padding="0,8"
                  Margin="0,0,24,0">
                                <Label Text="Body"
                     TextColor="#4F7CFF"
                     FontSize="13"
                     FontAttributes="Bold"/>
                            </Border>

                            <Border Grid.Column="1"
                  BackgroundColor="Transparent"
                  StrokeThickness="0"
                  Padding="0,8"
                  Margin="0,0,24,0">
                                <Label Text="Headers"
                     TextColor="#6B6D75"
                     FontSize="13"/>
                            </Border>

                            <Border Grid.Column="2"
                  BackgroundColor="Transparent"
                  StrokeThickness="0"
                  Padding="0,8">
                                <Label Text="Cookies"
                     TextColor="#6B6D75"
                     FontSize="13"/>
                            </Border>
                        </Grid>

                        <ScrollView Padding="24,16,24,24">
                            <Border BackgroundColor="#1A1C24"
                  StrokeThickness="0"
                  Padding="20,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Editor x:Name="response" HeightRequest="460"
                      BackgroundColor="Transparent"
                      TextColor="#E8E9ED"
                      FontSize="13"
                      IsReadOnly="True"
                      Text="Response will appear here after sending request"/>
                            </Border>
                        </ScrollView>

                    </VerticalStackLayout>

                </ScrollView>
            </Border>

        </Grid>
    </Grid>

</ContentPage>