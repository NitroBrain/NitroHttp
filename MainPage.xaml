<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NitroHttp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0A0B0F">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
        <Border
            Grid.Row="0"
            Margin="24"
            BackgroundColor="#12141A"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Column="1" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid Padding="4" ColumnDefinitions="Auto,*,Auto">
                        <Border
                            Grid.Column="0"
                            Padding="0,0"
                            StrokeThickness="0">
                            <Picker
                                x:Name="MethodPicker"
                                BackgroundColor="#1A1C24"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                TextColor="#FC4850"
                                WidthRequest="100">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>GET</x:String>
                                        <x:String>POST</x:String>
                                        <x:String>PUT</x:String>
                                        <x:String>PATCH</x:String>
                                        <x:String>DELETE</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>

                        <Entry
                            x:Name="apiUrl"
                            Grid.Column="1"
                            Margin="8,0"
                            BackgroundColor="#1A1C24"
                            FontSize="14"
                            Placeholder="https://api.example.com/v1/endpoint"
                            PlaceholderColor="#4A4C54"
                            TextColor="#FC4850" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    HeightRequest="44.8"
                    StrokeThickness="0">
                    <Button
                        BackgroundColor="#FC4850"
                        Clicked="Button_Click"
                        CornerRadius="4"
                        Text="Sumbit Request"
                        TextColor="#fff" />
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="24,20,24,0"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <Border
                x:Name="TabBody"
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="#FC4850"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Body" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabBodyLabel"
                    FontSize="13"
                    Text="Body"
                    TextColor="White" />
            </Border>

            <Border
                x:Name="TabParams"
                Grid.Column="1"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Params" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabParamsLabel"
                    FontSize="13"
                    Text="Params"
                    TextColor="#6B6D75" />
            </Border>

            <Border
                x:Name="TabHeaders"
                Grid.Column="2"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Headers" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabHeadersLabel"
                    FontSize="13"
                    Text="Headers"
                    TextColor="#6B6D75" />
            </Border>

            <Border
                x:Name="TabAuth"
                Grid.Column="3"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Auth" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabAuthLabel"
                    FontSize="13"
                    Text="Auth"
                    TextColor="#6B6D75" />
            </Border>

            <HorizontalStackLayout Grid.Column="5" Spacing="12">
                <Border
                    Padding="16,10"
                    BackgroundColor="#1A1C24"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="History"
                        TextColor="#6B6D75" />
                </Border>

                <Border
                    Padding="16,10"
                    BackgroundColor="#1A1C24"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="Collections"
                        TextColor="#6B6D75" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="24,20,24,24"
            ColumnDefinitions="1.3*,1.7*"
            ColumnSpacing="20">

            <ScrollView VerticalScrollBarVisibility="Never">

                <Border Padding="0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="*" RowSpacing="16">

                        <Border
                            x:Name="ContentParams"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="#12141A"
                            Stroke="#1A1C24"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#000000"
                                    Opacity="0.3"
                                    Radius="16"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="#14161D"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Query Parameters"
                                        TextColor="#E8E9ED" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="+ Add"
                                        TextColor="#FC4850" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="#1A1C24" />

                                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                                    <Grid
                                        Padding="20,16"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="12">
                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="*,*,Auto"
                                            ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                Padding="12,8"
                                                BackgroundColor="#1A1C24"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="key"
                                                    PlaceholderColor="#4A4C54"
                                                    TextColor="#E8E9ED" />
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="12,8"
                                                BackgroundColor="#1A1C24"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="value"
                                                    PlaceholderColor="#4A4C54"
                                                    TextColor="#E8E9ED" />
                                            </Border>

                                            <Label
                                                Grid.Column="2"
                                                FontSize="20"
                                                Text="×"
                                                TextColor="#6B6D75"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*,Auto"
                                            ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                Padding="12,8"
                                                BackgroundColor="#1A1C24"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="key"
                                                    PlaceholderColor="#4A4C54"
                                                    TextColor="#E8E9ED" />
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="12,8"
                                                BackgroundColor="#1A1C24"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="value"
                                                    PlaceholderColor="#4A4C54"
                                                    TextColor="#E8E9ED" />
                                            </Border>

                                            <Label
                                                Grid.Column="2"
                                                FontSize="20"
                                                Text="×"
                                                TextColor="#6B6D75"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </ScrollView>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentHeaders"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="#12141A"
                            IsVisible="False"
                            Stroke="#1A1C24"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#000000"
                                    Opacity="0.3"
                                    Radius="16"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="#14161D"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Headers"
                                        TextColor="#E8E9ED" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="+ Add"
                                        TextColor="#FC4850" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="#1A1C24" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="#1A1C24"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Content-Type: application/json"
                                        PlaceholderColor="#4A4C54"
                                        TextColor="#E8E9ED"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentBody"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="#12141A"
                            IsVisible="False"
                            Stroke="#1A1C24"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#000000"
                                    Opacity="0.3"
                                    Radius="16"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="#14161D"
                                    ColumnDefinitions="*,Auto,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Body"
                                        TextColor="#E8E9ED" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,16,0"
                                        FontSize="12"
                                        Text="JSON"
                                        TextColor="#FC4850"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontSize="12"
                                        Text="Beautify"
                                        TextColor="#6B6D75"
                                        VerticalOptions="Center" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="#1A1C24" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="#1A1C24"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Request body JSON"
                                        PlaceholderColor="#4A4C54"
                                        TextColor="#E8E9ED"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentAuth"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="#12141A"
                            IsVisible="False"
                            Stroke="#1A1C24"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#000000"
                                    Opacity="0.3"
                                    Radius="16"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="#14161D"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Authentication"
                                        TextColor="#E8E9ED" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="#1A1C24" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="#1A1C24"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Bearer token or API key"
                                        PlaceholderColor="#4A4C54"
                                        TextColor="#E8E9ED"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </ScrollView>

            <Border
                Grid.Column="1"
                Padding="0"
                BackgroundColor="#12141A"
                Stroke="#1A1C24"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.3"
                        Radius="16"
                        Offset="0,4" />
                </Border.Shadow>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout>
                        <Grid
                            Padding="24,20"
                            BackgroundColor="#14161D"
                            ColumnDefinitions="*,Auto">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Response"
                                TextColor="#E8E9ED"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="16">
                                <Label
                                    FontSize="12"
                                    Text="Save"
                                    TextColor="#6B6D75"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="12"
                                    Text="Copy"
                                    TextColor="#6B6D75"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#1A1C24" />

                        <Grid
                            Padding="24,16"
                            BackgroundColor="#0F1115"
                            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                            ColumnSpacing="20">

                            <Border
                                Grid.Column="0"
                                Padding="12,6"
                                BackgroundColor="#1A1C24"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label
                                    x:Name="status"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="NONE"
                                    TextColor="#4ADE80" />
                            </Border>

                            <Label
                                Grid.Column="2"
                                FontSize="12"
                                Text="324ms"
                                TextColor="#6B6D75"
                                VerticalOptions="Center" />

                            <BoxView
                                Grid.Column="3"
                                HeightRequest="16"
                                VerticalOptions="Center"
                                WidthRequest="1"
                                Color="#2A2C34" />

                            <Label
                                Grid.Column="4"
                                FontSize="12"
                                Text="2.4KB"
                                TextColor="#6B6D75"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#1A1C24" />

                        <Grid Padding="24,12,24,0" ColumnDefinitions="Auto,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Margin="0,0,24,0"
                                Padding="0,8"
                                BackgroundColor="Transparent"
                                StrokeThickness="0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Body"
                                    TextColor="#FC4850" />
                            </Border>

                            <Border
                                Grid.Column="1"
                                Margin="0,0,24,0"
                                Padding="0,8"
                                BackgroundColor="Transparent"
                                StrokeThickness="0">
                                <Label
                                    FontSize="13"
                                    Text="Headers"
                                    TextColor="#6B6D75" />
                            </Border>

                            <Border
                                Grid.Column="2"
                                Padding="0,8"
                                BackgroundColor="Transparent"
                                StrokeThickness="0">
                                <Label
                                    FontSize="13"
                                    Text="Cookies"
                                    TextColor="#6B6D75" />
                            </Border>
                        </Grid>

                        <ScrollView Padding="24,16,24,24">
                            <Border
                                Padding="20,16"
                                BackgroundColor="#1A1C24"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>
                                <Label
                                    x:Name="responseLabel"
                                    FontFamily="OpenSansRegular"
                                    FontSize="15"
                                    LineBreakMode="WordWrap" />
                            </Border>
                        </ScrollView>

                    </VerticalStackLayout>

                </ScrollView>
            </Border>

        </Grid>
    </Grid>

</ContentPage>
