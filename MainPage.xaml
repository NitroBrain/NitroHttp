<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NitroHttp.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Picker x:Name="MethodPicker" WidthRequest="100" SelectedIndex="0">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>GET</x:String>
                            <x:String>POST</x:String>
                            <x:String>PUT</x:String>
                            <x:String>DELETE</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry x:Name="ApiUrlEntry" Grid.Column="1" Placeholder="Enter API URL" HorizontalOptions="Fill" />

                <Button Grid.Column="2" Text="Send Request" Clicked="OnSendRequestClicked" />
            </Grid>

            <Label Text="Response:" FontAttributes="Bold" />

            <Editor x:Name="ResponseEditor"
            HeightRequest="300"
            IsReadOnly="True"
            AutoSize="TextChanges" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
