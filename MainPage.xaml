<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NitroHttp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight},
                                      Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
        <Border
            Grid.Row="0"
            Margin="24"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                              Dark={StaticResource CardBackgroundDark}}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Column="1" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid Padding="4" ColumnDefinitions="Auto,*,Auto">
                        <Border
                            Grid.Column="0"
                            Padding="0,0"
                            StrokeThickness="0">
                            <Picker
                                x:Name="MethodPicker"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                  Dark={StaticResource InputBackgroundDark}}"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource AccentPrimary}"
                                WidthRequest="100">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>GET</x:String>
                                        <x:String>POST</x:String>
                                        <x:String>PUT</x:String>
                                        <x:String>PATCH</x:String>
                                        <x:String>DELETE</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>

                        <Entry
                            x:Name="apiUrl"
                            Grid.Column="1"
                            Margin="8,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                              Dark={StaticResource InputBackgroundDark}}"
                            FontSize="14"
                            Placeholder="https://api.example.com/v1/endpoint"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                               Dark={StaticResource TextPlaceholderDark}}"
                            Text="http://jsonplaceholder.typicode.com/users/1"
                            TextColor="{StaticResource AccentPrimary}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    HeightRequest="44.8"
                    StrokeThickness="0">
                    <Button
                        BackgroundColor="{StaticResource AccentPrimary}"
                        Clicked="Button_Click"
                        CornerRadius="4"
                        Text="Nitro"
                        TextColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                    Dark={StaticResource TextPrimaryDark}}"
                        TextTransform="Uppercase" />
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="24,20,24,0"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <Border
                x:Name="TabBody"
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="{StaticResource AccentPrimary}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Body" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabBodyLabel"
                    FontSize="13"
                    Text="Body"
                    TextColor="White" />
            </Border>

            <Border
                x:Name="TabParams"
                Grid.Column="1"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Params" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabParamsLabel"
                    FontSize="13"
                    Text="Params"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                Dark={StaticResource TextMutedDark}}" />
            </Border>

            <Border
                x:Name="TabHeaders"
                Grid.Column="2"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Headers" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabHeadersLabel"
                    FontSize="13"
                    Text="Headers"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                Dark={StaticResource TextMutedDark}}" />
            </Border>

            <Border
                x:Name="TabAuth"
                Grid.Column="3"
                Margin="0,0,12,0"
                Padding="20,10"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Auth" Tapped="OnTabTapped" />
                </Border.GestureRecognizers>
                <Label
                    x:Name="TabAuthLabel"
                    FontSize="13"
                    Text="Auth"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                Dark={StaticResource TextMutedDark}}" />
            </Border>

            <HorizontalStackLayout Grid.Column="5" Spacing="12">
                <Border
                    Padding="16,10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                      Dark={StaticResource InputBackgroundDark}}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="History"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                    Dark={StaticResource TextMutedDark}}" />
                </Border>

                <Border
                    Padding="16,10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                      Dark={StaticResource InputBackgroundDark}}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="Collections"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                    Dark={StaticResource TextMutedDark}}" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="24,20,24,24"
            ColumnDefinitions="1.3*,1.7*"
            ColumnSpacing="20">

            <ScrollView VerticalScrollBarVisibility="Never">

                <Border Padding="0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="*" RowSpacing="16">

                        <Border
                            x:Name="ContentParams"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                              Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColorLight},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundAltLight},
                                                                      Dark={StaticResource CardBackgroundAltDark}}"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Query Parameters"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="+ Add"
                                        TextColor="{StaticResource AccentPrimary}" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                            Dark={StaticResource DividerColorDark}}" />

                                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                                    <Grid
                                        Padding="20,16"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="12">
                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="*,*,Auto"
                                            ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                Padding="12,8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                                  Dark={StaticResource InputBackgroundDark}}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="key"
                                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                                       Dark={StaticResource TextPlaceholderDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="12,8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                                  Dark={StaticResource InputBackgroundDark}}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="value"
                                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                                       Dark={StaticResource TextPlaceholderDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>

                                            <Label
                                                Grid.Column="2"
                                                FontSize="20"
                                                Text="×"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                            Dark={StaticResource TextMutedDark}}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*,Auto"
                                            ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                Padding="12,8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                                  Dark={StaticResource InputBackgroundDark}}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="key"
                                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                                       Dark={StaticResource TextPlaceholderDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="12,8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                                  Dark={StaticResource InputBackgroundDark}}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="13"
                                                    Placeholder="value"
                                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                                       Dark={StaticResource TextPlaceholderDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>

                                            <Label
                                                Grid.Column="2"
                                                FontSize="20"
                                                Text="×"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                            Dark={StaticResource TextMutedDark}}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </ScrollView>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentHeaders"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                              Dark={StaticResource CardBackgroundDark}}"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColorLight},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundAltLight},
                                                                      Dark={StaticResource CardBackgroundAltDark}}"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Headers"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="+ Add"
                                        TextColor="{StaticResource AccentPrimary}" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                            Dark={StaticResource DividerColorDark}}" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                      Dark={StaticResource InputBackgroundDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Content-Type: application/json"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                           Dark={StaticResource TextPlaceholderDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentBody"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                              Dark={StaticResource CardBackgroundDark}}"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColorLight},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundAltLight},
                                                                      Dark={StaticResource CardBackgroundAltDark}}"
                                    ColumnDefinitions="*,Auto,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Body"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,16,0"
                                        FontSize="12"
                                        Text="JSON"
                                        TextColor="{StaticResource AccentPrimary}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontSize="12"
                                        Text="Beautify"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                    Dark={StaticResource TextMutedDark}}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                            Dark={StaticResource DividerColorDark}}" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                      Dark={StaticResource InputBackgroundDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        x:Name="RequestBodyEditor"
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Request body JSON"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                           Dark={StaticResource TextPlaceholderDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentAuth"
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                              Dark={StaticResource CardBackgroundDark}}"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColorLight},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            VerticalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid
                                    Grid.Row="0"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundAltLight},
                                                                      Dark={StaticResource CardBackgroundAltDark}}"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Authentication"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                </Grid>

                                <BoxView
                                    Grid.Row="1"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                            Dark={StaticResource DividerColorDark}}" />

                                <Border
                                    Grid.Row="2"
                                    Margin="20,16,20,16"
                                    Padding="20,16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                                      Dark={StaticResource InputBackgroundDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <Editor
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        Placeholder="Bearer token or API key"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight},
                                                                           Dark={StaticResource TextPlaceholderDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                    Dark={StaticResource TextPrimaryDark}}"
                                        VerticalOptions="Fill" />
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </ScrollView>

            <Border
                Grid.Column="1"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight},
                                                  Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColorLight},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <Grid
                        Grid.Row="0"
                        Padding="20,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundAltLight},
                                                          Dark={StaticResource CardBackgroundAltDark}}"
                        ColumnDefinitions="*,Auto">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Response"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                        Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="16">
                            <Label
                                FontSize="12"
                                Text="Save"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="12"
                                Text="Copy"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView
                        Grid.Row="1"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                Dark={StaticResource DividerColorDark}}" />

                    <Grid
                        Grid.Row="2"
                        Padding="20,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight},
                                                          Dark={StaticResource PageBackgroundDark}}"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        ColumnSpacing="20">

                        <Border
                            Grid.Column="0"
                            Padding="12,6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                              Dark={StaticResource InputBackgroundDark}}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Label
                                x:Name="status"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="NONE"
                                TextColor="{StaticResource StatusSuccess}" />
                        </Border>

                        <Label
                            x:Name="responseTime"
                            Grid.Column="2"
                            FontSize="12"
                            Text="0ms"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                        Dark={StaticResource TextMutedDark}}"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Column="3"
                            HeightRequest="16"
                            VerticalOptions="Center"
                            WidthRequest="1"
                            Color="{AppThemeBinding Light={StaticResource BorderColorLight},
                                                    Dark={StaticResource BorderColorDark}}" />

                        <Label
                            x:Name="responseSize"
                            Grid.Column="4"
                            FontSize="12"
                            Text="0B"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                        Dark={StaticResource TextMutedDark}}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView
                        Grid.Row="3"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerColorLight},
                                                Dark={StaticResource DividerColorDark}}" />

                    <Grid
                        Grid.Row="4"
                        Padding="24,12,24,0"
                        ColumnDefinitions="Auto,Auto,Auto">
                        <Border
                            Grid.Column="0"
                            Margin="0,0,24,0"
                            Padding="0,8"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Body"
                                TextColor="{StaticResource AccentPrimary}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            Padding="0,8"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                            <Label
                                FontSize="13"
                                Text="Headers"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="0,8"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                            <Label
                                FontSize="13"
                                Text="Cookies"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}" />
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="5"
                        Margin="20,16,20,16"
                        Padding="20,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight},
                                                          Dark={StaticResource InputBackgroundDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <Label
                                x:Name="responseLabel"
                                FontFamily="OpenSansRegular"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                            Dark={StaticResource TextPrimaryDark}}" />
                        </ScrollView>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</ContentPage>
