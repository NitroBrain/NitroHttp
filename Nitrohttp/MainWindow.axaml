<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
xmlns:AvaloniaEditEditing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
xmlns:helpers="clr-namespace:AvaloniaApplication1.Helpers"
Icon="avares://NitroHttp/Assets/app.ico"
x:Class="NitroHttp.MainWindow"
Title="NitroHttp"
Width="1100" Height="600"
MinWidth="600" MinHeight="500"
Background="#101713">
    
    <Window.Resources>
        <SolidColorBrush x:Key="AccentPrimary" Color="#28A745"/>
        <SolidColorBrush x:Key="AccentPrimaryDark" Color="#1C5D37"/>
        
        <SolidColorBrush x:Key="PageBackground" Color="#101713"/>
        <SolidColorBrush x:Key="CardBackground" Color="#151F1A"/>
        <SolidColorBrush x:Key="CardBackgroundAlt" Color="#1B2A22"/>
        <SolidColorBrush x:Key="InputBackground" Color="#1F2F27"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B8C6BE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#95A79C"/>
        <SolidColorBrush x:Key="TextPlaceholder" Color="#63756A"/>
        
        <SolidColorBrush x:Key="BorderColor" Color="#2D3E34" />
        <SolidColorBrush x:Key="DividerColor" Color="#2D3E34"/>
        
        <SolidColorBrush x:Key="StatusSuccess" Color="#2ED573"/>
        <SolidColorBrush x:Key="StatusInfo" Color="#4CC9A6"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#FFA502"/>
        <SolidColorBrush x:Key="StatusError" Color="#E35D6A"/>
        
        <SolidColorBrush x:Key="SystemAccentColor" Color="#28A745"/>
        <SolidColorBrush x:Key="SystemAccentColorDark1" Color="#1C5D37"/>
        <SolidColorBrush x:Key="SystemAccentColorDark2" Color="#184E2E"/>
        <SolidColorBrush x:Key="SystemAccentColorDark3" Color="#133F25"/>
        <SolidColorBrush x:Key="SystemAccentColorLight1" Color="#4DBE67"/>
        <SolidColorBrush x:Key="SystemAccentColorLight2" Color="#73D18A"/>
        <SolidColorBrush x:Key="SystemAccentColorLight3" Color="#99E1AD"/>
    </Window.Resources>
    
    <Window.Styles>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="SelectionForegroundBrush" Value="#000000"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPrimary}"/>
        </Style>
        
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
        </Style>
        
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryDark}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
        </Style>
        
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryDark}"/>
        </Style>
        
        <Style Selector="ProgressBar /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
        </Style>

        <Style Selector="AvaloniaEditEditing|LineNumberMargin">
            <Setter Property="Margin" Value="0,0,25,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
        
        <Border Grid.Row="0" Margin="24" Background="{StaticResource CardBackground}" CornerRadius="5" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0">
                    <ComboBox x:Name="MethodPicker" Width="100" Padding="12" VerticalAlignment="Center" Background="{StaticResource InputBackground}"
                    Foreground="{StaticResource AccentPrimary}" SelectedIndex="0" BorderThickness="0">
                        <ComboBoxItem>GET</ComboBoxItem>
                        <ComboBoxItem>POST</ComboBoxItem>
                        <ComboBoxItem>PUT</ComboBoxItem>
                        <ComboBoxItem>PATCH</ComboBoxItem>
                        <ComboBoxItem>DELETE</ComboBoxItem>
                    </ComboBox>
                </Border>

                <TextBox x:Name="ApiUrl" Grid.Column="1" Margin="8,0"
                Background="{StaticResource InputBackground}"
                Foreground="{StaticResource AccentPrimary}"
                Watermark="https://api.example.com/v1/endpoint"
                Text="http://jsonplaceholder.typicode.com/users/1"
                VerticalAlignment="Center"
                Padding="12"
                BorderThickness="0"/>

                <Button Grid.Column="2" Padding="10" Content="NITRO" Background="{StaticResource AccentPrimary}"
                        Foreground="{StaticResource TextPrimary}" CornerRadius="4" Click="SendButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Border x:Name="TabBody" Grid.Column="0" Margin="0,0,12,0" Padding="20,10"
                    Background="{StaticResource AccentPrimary}" CornerRadius="5"
                    PointerPressed="OnTabTapped" Tag="Body">
                <TextBlock x:Name="TabBodyLabel" FontSize="13" Text="Body" Foreground="White"/>
            </Border>

            <Border x:Name="TabParams" Grid.Column="1" Margin="0,0,12,0" Padding="20,10"
                    Background="Transparent" CornerRadius="5"
                    PointerPressed="OnTabTapped" Tag="Params">
                <TextBlock x:Name="TabParamsLabel" FontSize="13" Text="Params" Foreground="{StaticResource TextMuted}"/>
            </Border>

            <Border x:Name="TabHeaders" Grid.Column="2" Margin="0,0,12,0" Padding="20,10"
                    Background="Transparent" CornerRadius="5"
                    PointerPressed="OnTabTapped" Tag="Headers">
                <TextBlock x:Name="TabHeadersLabel" FontSize="13" Text="Headers" Foreground="{StaticResource TextMuted}"/>
            </Border>

            <Border x:Name="TabAuth" Grid.Column="3" Margin="0,0,12,0" Padding="20,10"
                    Background="Transparent" CornerRadius="5"
                    PointerPressed="OnTabTapped" Tag="Auth">
                <TextBlock x:Name="TabAuthLabel" FontSize="13" Text="Auth" Foreground="{StaticResource TextMuted}"/>
            </Border>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12">
                <Button x:Name="HistoryButton" Padding="16,10" Background="{StaticResource InputBackground}"
                        Foreground="{StaticResource TextMuted}" CornerRadius="5" BorderThickness="0"
                        Click="OnHistoryButtonClick" Content="History"/>
                <Button x:Name="CollectionsButton" Padding="16,10" Background="{StaticResource InputBackground}"
                        Foreground="{StaticResource TextMuted}" CornerRadius="5" BorderThickness="0"
                        Click="OnCollectionsButtonClick" Content="Collections"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,20,24,24" ColumnDefinitions="1.3*,1.7*">
            
            <ScrollViewer Grid.Column="0" Margin="0,0,20,0">
                <Grid RowDefinitions="*">
                    
                    <Border x:Name="ContentParams" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontWeight="Bold" FontSize="14" Text="Query Parameters"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" Text="+ Add"
                                               Foreground="{StaticResource AccentPrimary}"/>
                                </Grid>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <ScrollViewer Grid.Row="2">
                                <Border Padding="20,16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <Border Grid.Column="0" Padding="12,8" Background="{StaticResource InputBackground}" CornerRadius="5">
                                                <TextBox Background="Transparent" FontSize="13" Watermark="key"
                                                Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                                            </Border>
                                            <Border Grid.Column="1" Margin="12,0" Padding="12,8" Background="{StaticResource InputBackground}" CornerRadius="5">
                                                <TextBox Background="Transparent" FontSize="13" Watermark="value"
                                                Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="20" Text="�"
                                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="ContentHeaders" IsVisible="False" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontWeight="Bold" FontSize="14" Text="Headers"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" Text="+ Add"
                                               Foreground="{StaticResource AccentPrimary}"/>
                                </Grid>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <Border Grid.Row="2" Margin="20,16" Padding="20,16"
                                    Background="{StaticResource InputBackground}" CornerRadius="5">
                                <AvaloniaEdit:TextEditor ShowLineNumbers="True" FontSize="14"  SyntaxHighlighting="Json" FontFamily="Monospace"
                                                         Foreground="{StaticResource TextPrimary}" Background="Transparent"/> 
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ContentBody" IsVisible="False" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock FontWeight="Bold" FontSize="14" Text="Body"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Margin="0,0,16,0" FontSize="12" Text="JSON"
                                               Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" FontSize="12" Text="Beautify"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <Border Grid.Row="2" Margin="20,16" Padding="20,16"
                                    Background="{StaticResource InputBackground}" CornerRadius="5">
                                <AvaloniaEdit:TextEditor ShowLineNumbers="True" FontSize="14" x:Name="RequestBodyEditor" SyntaxHighlighting="Json" FontFamily="Monospace"
                                                         Foreground="{StaticResource TextPrimary}" Background="Transparent"/> 
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ContentAuth" IsVisible="False" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <TextBlock FontWeight="Bold" FontSize="14" Text="Authentication"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <Border Grid.Row="2" Margin="20,16" Padding="20,16"
                                    Background="{StaticResource InputBackground}" CornerRadius="5">
                                <TextBox AcceptsReturn="True" Background="Transparent" FontSize="13"
                                Watermark="Bearer token or API key"
                                Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ContentHistory" IsVisible="False" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontWeight="Bold" FontSize="14" Text="History"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <Button Grid.Column="1" Content="Clear" Padding="10,4" Background="{StaticResource InputBackground}"
                                            Foreground="{StaticResource TextMuted}" BorderThickness="0" Click="OnClearHistoryClick"/>
                                </Grid>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <Border Grid.Row="2" Padding="20,16">
                                <ListBox x:Name="HistoryList" SelectionChanged="OnHistorySelectionChanged"
                                         Background="{StaticResource InputBackground}" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:RequestEntry">
                                            <StackPanel Margin="8,6">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TimestampText}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ContentCollections" IsVisible="False" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                                <TextBlock FontWeight="Bold" FontSize="14" Text="Collections"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>
                            <Grid Grid.Row="2" Margin="20,16,20,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="CollectionNameBox" Grid.Column="0" Background="{StaticResource InputBackground}"
                                         Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,8"
                                         Watermark="Collection item name"/>
                                <Button Grid.Column="1" Content="Save Current" Padding="10,8" Background="{StaticResource InputBackground}"
                                        Foreground="{StaticResource TextPrimary}" BorderThickness="0" Click="OnSaveToCollectionClick"/>
                                <Button Grid.Column="2" Content="Delete" Padding="10,8" Background="{StaticResource InputBackground}"
                                        Foreground="{StaticResource TextMuted}" BorderThickness="0" Click="OnDeleteCollectionClick"/>
                            </Grid>
                            <Border Grid.Row="3" Margin="20,12,20,16">
                                <ListBox x:Name="CollectionsList" SelectionChanged="OnCollectionSelectionChanged"
                                         Background="{StaticResource InputBackground}" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:RequestEntry">
                                            <StackPanel Margin="8,6">
                                                <TextBlock Text="{Binding CollectionName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Padding="20,16" Background="{StaticResource CardBackgroundAlt}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontWeight="Bold" FontSize="16" Text="Response"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                <TextBlock FontSize="12" Text="Save" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Text="Copy" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerColor}"/>

                    <Border Grid.Row="2" Padding="20,16" Background="{StaticResource PageBackground}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                            <Border Grid.Column="0" Padding="12,6" Background="{StaticResource InputBackground}" CornerRadius="6">
                                <TextBlock x:Name="Status" FontWeight="Bold" FontSize="12" Text="NULL"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <Rectangle Grid.Column="1" Width="1" Height="16" Fill="Transparent"/>
                            <TextBlock x:Name="ResponseCount" Grid.Column="2" FontSize="12" Text="0"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>

                            <Rectangle Grid.Column="3" Width="1" Height="16" Fill="{StaticResource BorderColor}"
                                       VerticalAlignment="Center" Margin="20,0"/>

                            <TextBlock x:Name="ResponseTime" Grid.Column="4" FontSize="12" Text="0ms"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="5" Width="1" Height="16" Fill="{StaticResource BorderColor}"
                                       VerticalAlignment="Center" Margin="20,0"/>

                            <TextBlock x:Name="ResponseSize" Grid.Column="6" FontSize="12" Text="0B"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource DividerColor}"/>

                    <Border Grid.Row="4" Padding="24,12,24,0" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Border PointerPressed="OnResponseTabTapped" Tag="Content" Margin="0,0,24,0" Padding="0,8" Background="Transparent">
                                <TextBlock x:Name="ResponseContentTab" FontWeight="Bold" FontSize="13" Text="Body" Foreground="{StaticResource AccentPrimary}"/>
                            </Border>
                            <Border PointerPressed="OnResponseTabTapped" Tag="Headers" Margin="0,0,24,0" Padding="0,8" Background="Transparent">
                                <TextBlock x:Name="ResponseHeadersTab" FontWeight="Bold" FontSize="13" Text="Headers" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <Border PointerPressed="OnResponseTabTapped" Tag="Cookies" Padding="0,8" Background="Transparent">
                                <TextBlock x:Name="ResponseCookiesTab" FontWeight="Bold" FontSize="13" Text="Cookies" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="5" Margin="20,16">
                        <Border x:Name="ResponseContent" Padding="20,16"
                                Background="{StaticResource InputBackground}" CornerRadius="5">
                            <ScrollViewer>
                                <AvaloniaEdit:TextEditor ShowLineNumbers="True" IsReadOnly="True" FontSize="14" x:Name="ResponseLabel" SyntaxHighlighting="Json" FontFamily="Monospace"
                                                         Foreground="{StaticResource TextPrimary}" Background="Transparent"/> 
                            </ScrollViewer>
                        </Border>
                        
                        <Border x:Name="ResponseHeaders" Padding="20,16"
                                Background="{StaticResource InputBackground}" CornerRadius="5">
                            <ScrollViewer>
                                <TextBlock x:Name="ResponseHeadersLabel" Text="Headers shown here..." FontSize="13" TextWrapping="Wrap"
                                           FontFamily="Consolas, Courier New, monospace"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </ScrollViewer>
                        </Border>
                        
                        <Border x:Name="ResponseCookies" Padding="20,16"
                                Background="{StaticResource InputBackground}" CornerRadius="5">
                            <ScrollViewer>
                                <TextBlock x:Name="ResponseCookiesLabel" Text="Cookies shown here..." FontSize="13" TextWrapping="Wrap"
                                           FontFamily="Consolas, Courier New, monospace"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="LoadingOverlay" IsVisible="False"
                                Background="#8A0E1311" CornerRadius="8">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MinWidth="260" Padding="20,16"
                                    Background="{StaticResource CardBackgroundAlt}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Sending request"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <ProgressBar IsIndeterminate="True" Width="180" Height="6"
                                                 Foreground="{StaticResource AccentPrimary}"
                                                 Background="{StaticResource InputBackground}"/>
                                    <TextBlock FontSize="12" Text="Please wait..."
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
